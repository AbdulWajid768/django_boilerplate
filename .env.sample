# --- General ---
ENVIRONMENT=local
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
TIME_ZONE=Asia/Karachi

# --- Database ---
# Set USE_SQLITE=true (or leave DB_NAME blank) for a zero-config local SQLite db.
USE_SQLITE=true
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# --- CORS ---
CORS_ALLOW_ALL_ORIGINS=false
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Google OAuth ---
# Same Google client id is used by both backend (verifying id_tokens) and Next.js Auth.js.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Maria's notifications) ---
# Dev default: console backend prints emails to runserver stdout.
# Prod: set EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend and fill the rest.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@mariashoaib.com
NOTIFICATION_EMAIL=contact@mariashoaib.com
